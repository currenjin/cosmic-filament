{
  "name": "cosmic-filament",
  "version": "0.1.0",
  "description": "Explore the filaments connecting indexed thoughts.",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
