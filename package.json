    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint ."
  },
  "repository": { "type": "git", "url": "git+https://github.com/currenjin/cosmic-filament.git" },
  "keywords": ["thought-graph", "cytoscape", "digital-garden"],
